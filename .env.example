# Copy to .env for local testing. On DigitalOcean, add these under
# the app's web component > Environment Variables and tick "Encrypt".
# Real values never go into git.

# The Gmail account the website sends lead emails from
GMAIL_USER=your.sender@gmail.com

# A 16-character App Password for that account (needs 2-Step Verification on;
# create it at Google Account > Security > App passwords)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where every quote request is delivered
LEAD_NOTIFY_EMAIL=removal@miamibeerescue.com

# Set to 1 to print emails to the console instead of sending them
# MAIL_DRY_RUN=1
